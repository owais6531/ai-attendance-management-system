# ---- Database -----------------------------------------------------------
# Leave DATABASE_URL empty to use SQLite at ./data/attendance.db (zero setup).
# MySQL / MariaDB (typical cPanel shared hosting):
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/attendance
# PostgreSQL:
#   DATABASE_URL=postgresql://user:password@localhost:5432/attendance
DATABASE_URL=

# Legacy PostgreSQL settings (used only when DATABASE_URL is empty and DB_PASSWORD is set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=attendanceapp
# DB_USER=postgres
# DB_PASSWORD=

# Run database migrations automatically on startup
AUTO_MIGRATE=True
# Log every SQL statement (debugging only)
ECHO_SQL=False

# ---- App ----------------------------------------------------------------
APP_NAME=AI Attendance Management System
MAX_UPLOAD_MB=20
# Optional: require this value in the X-API-Key header on /upload and /api routes.
# Leave empty to run without auth (local use only).
API_KEY=
# HOST=127.0.0.1
# PORT=8000
# DEBUG=False

# ---- AI (optional) -------------------------------------------------------
# The app works fully without AI. Choose: ollama (free, on this computer), api (your own key), off
# AI_PROVIDER=ollama
#
# Option 1: Ollama (about 8 GB RAM, 6 GB free disk, 4 CPU cores)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_TEXT_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT=120
#
# Option 2: your own key, any OpenAI-compatible service. Keep the key only in .env, never in git.
# The provider receives the headings and up to 3 sample values of unmatched columns.
# AI_API_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_API_MODEL=
# AI_API_TIMEOUT=60
